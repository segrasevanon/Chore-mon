# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.

# ── Runtime environment ──────────────────────────────
# local  → custom JWT + LocalFileStorage + FCM log-only
# azure  → Azure AD B2C + Azure Blob Storage
ENV=local

# ── Database (local Docker SQL Server) ──────────────
DB_HOST=localhost
DB_PORT=1433
DB_NAME=choreemon
DB_USER=sa
DB_PASSWORD=Local_Dev_P@ss1

# ── JWT (local auth only — not used when ENV=azure) ──
JWT_SECRET=change-this-to-a-long-random-string-before-sharing
JWT_ISSUER=choreemon
JWT_EXPIRY_HOURS=168

# ── Storage (MinIO for local, Azure Blob for prod) ───
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=photos
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_UPLOAD_DIR=./uploads

# ── Push notifications ───────────────────────────────
# Leave blank locally — notifications will be logged to console.
# Set to your FCM server key for real push delivery.
FCM_SERVER_KEY=

# ── Azure (only needed when ENV=azure) ───────────────
# AZURE_STORAGE_ACCOUNT=stchoremon
# AZURE_STORAGE_KEY=
# AZURE_B2C_TENANT=choremonb2c.onmicrosoft.com
# AZURE_B2C_CLIENT_ID=
# AZURE_NOTIFICATION_HUB_CONNECTION=
# AZURE_NOTIFICATION_HUB_NAME=
