digraph ER {
graph [rankdir=LR, bgcolor="white", pad=0.35, nodesep=0.55, ranksep=0.85, splines=ortho, fontname="Arial", label="Choreemon backend physical schema", labelloc=t, fontsize=22];
node [shape=plain, fontname="Arial", fontsize=12];
edge [fontname="Arial", fontsize=10, color="#60758B", arrowsize=0.8, arrowhead=odotcrow, arrowtail=teetee, dir=both];
Households [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#CBD5E1"><TR><TD COLSPAN="2" BGCOLOR="#183B56"><FONT COLOR="white"><B>Households</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">PK</TD><TD PORT="id" ALIGN="LEFT" BGCOLOR="white">id  NVARCHAR(36)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F1F5F9"></TD><TD PORT="name" ALIGN="LEFT" BGCOLOR="#F1F5F9">name  NVARCHAR(100)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"></TD><TD PORT="invite_code" ALIGN="LEFT" BGCOLOR="white">invite_code  NVARCHAR(12)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F1F5F9"></TD><TD PORT="pin_salt" ALIGN="LEFT" BGCOLOR="#F1F5F9">pin_salt  NVARCHAR(32)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"></TD><TD PORT="pin_hash" ALIGN="LEFT" BGCOLOR="white">pin_hash  NVARCHAR(64)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F1F5F9"></TD><TD PORT="week_start" ALIGN="LEFT" BGCOLOR="#F1F5F9">week_start  NVARCHAR(10)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"></TD><TD PORT="created_at" ALIGN="LEFT" BGCOLOR="white">created_at  NVARCHAR(50)</TD></TR></TABLE>>];
Members [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#CBD5E1"><TR><TD COLSPAN="2" BGCOLOR="#183B56"><FONT COLOR="white"><B>Members</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">PK</TD><TD PORT="id" ALIGN="LEFT" BGCOLOR="white">id  NVARCHAR(36)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F1F5F9">FK</TD><TD PORT="household_id" ALIGN="LEFT" BGCOLOR="#F1F5F9">household_id  NVARCHAR(36)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"></TD><TD PORT="auth_email" ALIGN="LEFT" BGCOLOR="white">auth_email  NVARCHAR(256) NULL</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F1F5F9"></TD><TD PORT="auth_password_hash" ALIGN="LEFT" BGCOLOR="#F1F5F9">auth_password_hash  NVARCHAR(256) NULL</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"></TD><TD PORT="name" ALIGN="LEFT" BGCOLOR="white">name  NVARCHAR(64)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F1F5F9"></TD><TD PORT="avatar" ALIGN="LEFT" BGCOLOR="#F1F5F9">avatar  INT</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"></TD><TD PORT="points" ALIGN="LEFT" BGCOLOR="white">points  INT</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F1F5F9"></TD><TD PORT="weekly_points" ALIGN="LEFT" BGCOLOR="#F1F5F9">weekly_points  INT</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"></TD><TD PORT="is_parent" ALIGN="LEFT" BGCOLOR="white">is_parent  BIT</TD></TR></TABLE>>];
Creatures [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#CBD5E1"><TR><TD COLSPAN="2" BGCOLOR="#183B56"><FONT COLOR="white"><B>Creatures</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">PK</TD><TD PORT="id" ALIGN="LEFT" BGCOLOR="white">id  NVARCHAR(36)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F1F5F9">FK</TD><TD PORT="owner_id" ALIGN="LEFT" BGCOLOR="#F1F5F9">owner_id  NVARCHAR(36)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"></TD><TD PORT="element" ALIGN="LEFT" BGCOLOR="white">element  NVARCHAR(10)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F1F5F9"></TD><TD PORT="rarity" ALIGN="LEFT" BGCOLOR="#F1F5F9">rarity  NVARCHAR(12)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"></TD><TD PORT="xp" ALIGN="LEFT" BGCOLOR="white">xp  INT</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F1F5F9"></TD><TD PORT="stage" ALIGN="LEFT" BGCOLOR="#F1F5F9">stage  INT</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"></TD><TD PORT="nickname" ALIGN="LEFT" BGCOLOR="white">nickname  NVARCHAR(64)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F1F5F9"></TD><TD PORT="adopted_date" ALIGN="LEFT" BGCOLOR="#F1F5F9">adopted_date  NVARCHAR(10)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"></TD><TD PORT="loved_on" ALIGN="LEFT" BGCOLOR="white">loved_on  NVARCHAR(10)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F1F5F9"></TD><TD PORT="is_favorite" ALIGN="LEFT" BGCOLOR="#F1F5F9">is_favorite  BIT</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"></TD><TD PORT="is_active" ALIGN="LEFT" BGCOLOR="white">is_active  BIT</TD></TR></TABLE>>];
Chores [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#CBD5E1"><TR><TD COLSPAN="2" BGCOLOR="#183B56"><FONT COLOR="white"><B>Chores</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">PK</TD><TD PORT="id" ALIGN="LEFT" BGCOLOR="white">id  NVARCHAR(36)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F1F5F9">FK</TD><TD PORT="household_id" ALIGN="LEFT" BGCOLOR="#F1F5F9">household_id  NVARCHAR(36)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"></TD><TD PORT="title" ALIGN="LEFT" BGCOLOR="white">title  NVARCHAR(100)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F1F5F9"></TD><TD PORT="description" ALIGN="LEFT" BGCOLOR="#F1F5F9">description  NVARCHAR(500)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"></TD><TD PORT="points" ALIGN="LEFT" BGCOLOR="white">points  INT</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F1F5F9"></TD><TD PORT="element" ALIGN="LEFT" BGCOLOR="#F1F5F9">element  NVARCHAR(10)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"></TD><TD PORT="schedule" ALIGN="LEFT" BGCOLOR="white">schedule  NVARCHAR(12)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F1F5F9"></TD><TD PORT="requires_approval" ALIGN="LEFT" BGCOLOR="#F1F5F9">requires_approval  BIT</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"></TD><TD PORT="archived" ALIGN="LEFT" BGCOLOR="white">archived  BIT</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F1F5F9"></TD><TD PORT="steps" ALIGN="LEFT" BGCOLOR="#F1F5F9">steps  NVARCHAR(MAX)</TD></TR></TABLE>>];
ChoreAssignments [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#CBD5E1"><TR><TD COLSPAN="2" BGCOLOR="#183B56"><FONT COLOR="white"><B>ChoreAssignments</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">PK FK</TD><TD PORT="chore_id" ALIGN="LEFT" BGCOLOR="white">chore_id  NVARCHAR(36)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F1F5F9">PK FK</TD><TD PORT="member_id" ALIGN="LEFT" BGCOLOR="#F1F5F9">member_id  NVARCHAR(36)</TD></TR></TABLE>>];
Completions [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#CBD5E1"><TR><TD COLSPAN="2" BGCOLOR="#183B56"><FONT COLOR="white"><B>Completions</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">PK</TD><TD PORT="id" ALIGN="LEFT" BGCOLOR="white">id  NVARCHAR(36)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F1F5F9">FK</TD><TD PORT="chore_id" ALIGN="LEFT" BGCOLOR="#F1F5F9">chore_id  NVARCHAR(36)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">FK</TD><TD PORT="member_id" ALIGN="LEFT" BGCOLOR="white">member_id  NVARCHAR(36)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F1F5F9">FK</TD><TD PORT="creature_id" ALIGN="LEFT" BGCOLOR="#F1F5F9">creature_id  NVARCHAR(36)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"></TD><TD PORT="date" ALIGN="LEFT" BGCOLOR="white">date  NVARCHAR(10)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F1F5F9"></TD><TD PORT="title" ALIGN="LEFT" BGCOLOR="#F1F5F9">title  NVARCHAR(100)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"></TD><TD PORT="points" ALIGN="LEFT" BGCOLOR="white">points  INT</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F1F5F9"></TD><TD PORT="xp" ALIGN="LEFT" BGCOLOR="#F1F5F9">xp  INT</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"></TD><TD PORT="status" ALIGN="LEFT" BGCOLOR="white">status  NVARCHAR(10)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F1F5F9"></TD><TD PORT="photo_url" ALIGN="LEFT" BGCOLOR="#F1F5F9">photo_url  NVARCHAR(500)</TD></TR></TABLE>>];
DeviceTokens [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#CBD5E1"><TR><TD COLSPAN="2" BGCOLOR="#183B56"><FONT COLOR="white"><B>DeviceTokens</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">PK</TD><TD PORT="id" ALIGN="LEFT" BGCOLOR="white">id  NVARCHAR(36)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F1F5F9">FK</TD><TD PORT="member_id" ALIGN="LEFT" BGCOLOR="#F1F5F9">member_id  NVARCHAR(36)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"></TD><TD PORT="fcm_token" ALIGN="LEFT" BGCOLOR="white">fcm_token  NVARCHAR(256)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F1F5F9"></TD><TD PORT="platform" ALIGN="LEFT" BGCOLOR="#F1F5F9">platform  NVARCHAR(10)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"></TD><TD PORT="updated_at" ALIGN="LEFT" BGCOLOR="white">updated_at  NVARCHAR(50)</TD></TR></TABLE>>];
ClaimedMilestones [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#CBD5E1"><TR><TD COLSPAN="2" BGCOLOR="#183B56"><FONT COLOR="white"><B>ClaimedMilestones</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">PK FK</TD><TD PORT="member_id" ALIGN="LEFT" BGCOLOR="white">member_id  NVARCHAR(36)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F1F5F9">PK</TD><TD PORT="milestone_key" ALIGN="LEFT" BGCOLOR="#F1F5F9">milestone_key  NVARCHAR(64)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"></TD><TD PORT="claimed_at" ALIGN="LEFT" BGCOLOR="white">claimed_at  NVARCHAR(50)</TD></TR></TABLE>>];
Households -> Members;
Members -> Creatures;
Households -> Chores;
Chores -> ChoreAssignments;
Members -> ChoreAssignments;
Chores -> Completions;
Members -> Completions;
Creatures -> Completions;
Members -> DeviceTokens;
Members -> ClaimedMilestones;
}